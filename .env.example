# Ports (modifier ici pour changer les ports de dev)
DB_PORT=5437
PORT=3010

DATABASE_URL="postgresql://recettes:recettes@localhost:${DB_PORT}/recettes?schema=public"
APPROVAL_THRESHOLD=2

# Compte admin par défaut (créé/promu au démarrage, sert à se connecter)
ADMIN_NAME="Admin"
ADMIN_EMAIL="admin@famille.fr"

# URL de l'application
APP_URL="http://localhost:${PORT}"

# Connexion avec Google (optionnel ; sinon seul le lien magique est proposé)
# Console Google Cloud > Identifiants > ID client OAuth (application Web)
# URI de redirection autorisée : ${APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Configuration email (Brevo SMTP)
SMTP_HOST="smtp-relay.brevo.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Carnet de Recettes <recettes@famille.fr>"

# Stockage des photos (S3 ou compatible : Scaleway, OVH, MinIO...)
S3_BUCKET=""
S3_REGION="eu-west-3"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Laisser vide pour AWS ; renseigner pour un S3 compatible
S3_ENDPOINT=""
S3_FORCE_PATH_STYLE="false"

# Import de recette par photo (API Anthropic). Sans clé, la fonctionnalité est désactivée.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5-5"
# Nombre maximal d'imports par jour et par membre
IMPORT_DAILY_LIMIT=20
