# Ports (modifier ici pour changer les ports de dev)
DB_PORT=5437
PORT=3010

DATABASE_URL="postgresql://recettes:recettes@localhost:${DB_PORT}/recettes?schema=public"
APPROVAL_THRESHOLD=2

# Compte admin (créé au premier lancement)
ADMIN_NAME="Admin"
ADMIN_EMAIL="admin@famille.fr"

# URL de l'application
APP_URL="http://localhost:${PORT}"

# Configuration email (Brevo SMTP)
SMTP_HOST="smtp-relay.brevo.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Carnet de Recettes <recettes@famille.fr>"

# Stockage des photos (S3 ou compatible : Scaleway, OVH, MinIO...)
S3_BUCKET=""
S3_REGION="eu-west-3"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Laisser vide pour AWS ; renseigner pour un S3 compatible
S3_ENDPOINT=""
S3_FORCE_PATH_STYLE="false"
